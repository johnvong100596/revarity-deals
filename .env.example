# Revarity Marketing Engine — environment template.
# Copy to .env.local and fill real values. NEVER commit .env.local.

# ── Image render: Nano Banana via the Google Gemini API (model-routing.json → image_render)
# Google AI Studio key, format starts with "AIza...". https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Higgsfield MCP: B-roll / motion only (model-routing.json → higgsfield_mcp, video_broll)
# Cloud key-id + secret from cloud.higgsfield.ai. MCP bearer = "<id>:<secret>" (combined).
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# ── Anthropic: QA reviewer (model-routing.json → qa_review = Haiku, escalates to Sonnet)
# Without this, qa.mjs falls back to gemini-2.5-flash. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── PriceLabs: calculator market data (model-routing.json → pricelabs)
# Market Dashboard bands + Revenue Estimator API (server-side, post-capture only)
PRICELABS_API_KEY=

# ── Lead capture (income calculator). Injected at deploy, never hardcoded.
REACT_APP_GHL_WEBHOOK_URL=
REACT_APP_BOOKING_URL=
