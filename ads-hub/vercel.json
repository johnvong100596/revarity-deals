{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/run/route.js": { "maxDuration": 300 },
    "app/api/cron/route.js": { "maxDuration": 300 },
    "app/api/cron/render/route.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "0 * * * *" },
    { "path": "/api/cron/render", "schedule": "0 9 * * *" }
  ]
}
