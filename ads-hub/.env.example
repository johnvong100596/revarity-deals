# Revarity Ads Hub — environment template. Copy to .env.local (gitignored).

# Internal auth (MVP default). Comma-separated user:pass. Empty = open local dev.
HUB_BASIC_AUTH=

# Engine output location, relative to the hub cwd (local/VM). Default: parent project.
ENGINE_DIR=..

# Storage driver: fs (local, default) | cloud (Vercel Blob only, for deploy)
STORE_DRIVER=fs

# ── cloud store (STORE_DRIVER=cloud) — Vercel Blob, auto-injected when the store is linked ──
BLOB_READ_WRITE_TOKEN=

# ── Clerk auth (see CLERK.md; AUTH_PROVIDER=clerk to activate) ──
AUTH_PROVIDER=basic
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Phase 2 (Monitor): read-only metrics. Unused until spend is live. ──
GHL_API_KEY=
META_ADS_ACCESS_TOKEN=
