# Revarity Ads Hub — environment template. Copy to .env.local (gitignored).

# Internal auth (MVP default). Comma-separated user:pass. Empty = open local dev.
HUB_BASIC_AUTH=

# Engine output location, relative to the hub cwd (local/VM). Default: parent project.
ENGINE_DIR=..

# Storage driver: fs (local, default) | cloud (Vercel Blob only, for deploy)
STORE_DRIVER=fs

# ── cloud store (STORE_DRIVER=cloud) — Vercel Blob, auto-injected when the store is linked ──
BLOB_READ_WRITE_TOKEN=

# ── Clerk auth (see CLERK.md; AUTH_PROVIDER=clerk to activate) ──
AUTH_PROVIDER=basic
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Generation keys (server-side ONLY — never expose to the client) ──
# Copy generation + predictive Creative Score (Anthropic Messages API). Required for Create + scoring.
ANTHROPIC_API_KEY=
COPY_MODEL=claude-sonnet-4-6
# SCORE_MODEL: model for the Creative Score (Hook/Viral/Response/Retention-risk). Defaults to COPY_MODEL.
SCORE_MODEL=
# Image render (Gemini "Nano Banana"), Lyria music, AND Veo video all use this one Gemini key.
GEMINI_API_KEY=
IMG_MODEL=gemini-3.1-flash-image-preview
IMG_FINAL_MODEL=gemini-3-pro-image-preview
LYRIA_MODEL=lyria-3-clip-preview
VEO_MODEL=veo-3.1-generate-preview
VEO_URL=
# Video via fal.ai (default "kling" engine). Format: key_id:key_secret
FAL_KEY=
# Voiceover via ElevenLabs (TTS over b-roll — D-03: never lip-synced/talking-head).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_URL=
# Higgsfield image→video fallback engine (cloud store only).
HF_API_KEY=
HF_API_SECRET=

# ── Phase 2 (Monitor): read-only metrics. Unused until spend is live. ──
GHL_API_KEY=
META_ADS_ACCESS_TOKEN=
