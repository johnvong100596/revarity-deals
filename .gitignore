# Secrets — never commit. Real values live in .env.local (and the deploy env).
.env
.env.local
.env.*.local
*.key

# Node / build
node_modules/
ads-hub/.next/
ads-hub/.vercel/

# Generated run artifacts (regenerated by the pipeline; not needed in the repo —
# on deploy these live in Postgres/Blob). Keep the dir.
creative-engine/output/*
!creative-engine/output/.gitkeep

# Heavy hero source/alternate video renders — regenerated by ads-hub/scripts/, excluded from deploy
# via ads-hub/.vercelignore. Production needs only hero-loop.mp4 + the 8 stills. Kept on disk, out of git.
ads-hub/public/hero/clips/
ads-hub/public/hero/veo-seg/
ads-hub/public/hero/hero-veo.mp4
ads-hub/public/hero/hero-veo-long.mp4
ads-hub/public/hero/hero-loop-higgsfield.mp4
ads-hub/public/hero/hero-loop-prev.mp4

# Runtime-generated media (fs driver writes here; in prod these live in Vercel Blob).
ads-hub/public/gen-audio/
ads-hub/public/gen-video/
ads-hub/public/gen-src/

# scratch
_domtest/
*.tmp
